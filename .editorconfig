# Réglages communs aux éditeurs : mêmes conventions que Prettier et .gitattributes
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Deux espaces en fin de ligne = saut de ligne Markdown
trim_trailing_whitespace = false
